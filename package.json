{
  "name": "ctfvault",
  "version": "0.1.0",
  "private": true,
  "description": "Hybrid database CTF platform — dynamic scoring and semantic search",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:reset": "bash scripts/reset_db.sh",
    "db:flags": "node --env-file=.env.local scripts/issue_flags.mjs",
    "db:demo": "node --env-file=.env.local scripts/seed_demo.mjs && psql -q -f db/08_demo_timeline.sql",
    "db:test": "psql -f tests/test_scoring.sql",
    "test:race": "python3 tests/concurrency_test.py --teams 60 --rounds 10",
    "bench:leaderboard": "python3 tests/bench_leaderboard.py",
    "embed:service": "uvicorn scripts.embedding_service:app --host 127.0.0.1 --port 8000",
    "embed:backfill": "python3 scripts/backfill_embeddings.py"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pg": "^8.13.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.0"
  }
}
