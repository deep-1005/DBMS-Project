# =====================================================================
# CTFVault — environment configuration
#
# Copy to .env.local and fill in. .env.local is gitignored; no credential
# is ever committed (rubric items 10 and 13).
#
#   cp .env.example .env.local
# =====================================================================

# ---- PostgreSQL -----------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=ctfvault
PGPASSWORD=
PGDATABASE=ctfvault
PGPOOL_MAX=10
# Set to "require" in production to force a verified TLS connection.
PGSSL=

# ---- Application secrets -------------------------------------------
# Generate each with:  openssl rand -hex 32
# Changing FLAG_SIGNING_SECRET invalidates every issued flag.
FLAG_SIGNING_SECRET=
SESSION_SECRET=

# ---- Embedding service (owned by Subhransi) -------------------------
# Model used to embed writeups and hints, and its vector width. The width
# must match the VECTOR(n) column type in db/10_vector_schema.sql.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_SERVICE_URL=http://localhost:8000

# ---- Debugging ------------------------------------------------------
# Set to 1 to log every SQL statement with its duration.
LOG_SQL=0
